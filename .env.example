# ═══════════════════════════════════════════════════════
# Post-Pilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ── Flask core ──────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-32-char-string
TOKEN_ENCRYPTION_KEY=change-me-to-a-valid-fernet-key-from-cryptography
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── App environment ─────────────────────────────────────
APP_ENV=development
FLASK_ENV=development

# ── Database ─────────────────────────────────────────────
# Local dev (SQLite): leave DATABASE_URL unset; DATABASE_PATH is used instead.
# Production (Vercel + Supabase): set DATABASE_URL to the Supabase pooler URL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_PATH=postpilot.db

# ── Supabase (auth + storage) ────────────────────────────
# Required for magic-link auth and Supabase client features.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Service role key is used server-side only — never expose to the browser.

# ── Redis (REQUIRED in production for rate limiting) ─────
# Without this, each serverless instance has its own rate-limit counter.
# Local dev: leave commented out (falls back to memory://).
# Production: Upstash Redis URL in Vercel env vars.
# REDIS_URL=redis://default:<password>@<host>:<port>

# ── OpenAI (required for AI caption generation) ─────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM gateway (provider-agnostic routing) ──────────────
# Any subset of providers may be configured; none is required.
# AI_DEFAULT_PROVIDER=Muse
# AI_FALLBACK_ORDER=Muse,openai,anthropic,gemini
# AI_TASK_ROUTES={"content": ["Muse", "anthropic"]}
# Muse (local endpoint)
# CLAUDE_API_URL=http://127.0.0.1:7777/v1/generate
# CLAUDE_API_KEY=
# CLAUDE_MODEL=Muse
# Claude (Anthropic API; pip install anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Gemini (pip install google-genai)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# ── Stripe (required for billing) ───────────────────────
# Tiers: Free / Starter / Pro / Agency (no Growth tier)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# ── Sentry (optional — error monitoring) ─────────────────
# Leave blank in dev to disable. Set in Vercel production.
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/xxx

# ── Cron jobs (REQUIRED in production) ───────────────────
# Authenticates Vercel Cron calls to /api/cron/*
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value in Vercel environment variables.
CRON_SECRET=change-me-to-a-random-urlsafe-string

# ── Meta — Facebook Pages + Instagram Business ──────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
REDIRECT_URI=http://localhost:5000/auth/facebook/callback
# Production: https://<your-domain>/auth/facebook/callback

# ── Google — Business Profile + YouTube ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Production: https://<your-domain>/auth/google/callback

# ── TikTok ──────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/auth/tiktok/callback
# Production: https://<your-domain>/auth/tiktok/callback

# ── Twitter / X ──────────────────────────────────────────
# Create an app at https://developer.twitter.com/
# App type: Web App  (enables client_secret + PKCE)
# Required scopes: tweet.read  tweet.write  users.read  offline.access
# Register callback URL in app settings.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5000/auth/twitter/callback
# Production: https://<your-domain>/auth/twitter/callback

# ── Dev-only login bypass ────────────────────────────────
# Must be ABSENT or empty in Vercel production.
# DEV_LOGIN_KEY=

# ── Email / notifications (optional) ─────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SENDGRID_API_KEY=  (alternative to SMTP_PASSWORD)
# FROM_EMAIL=noreply@postpilotpro.com
# FROM_NAME=PostPilot Pro
# APP_URL=http://localhost:5000  (used for dashboard/unsubscribe links; auth default is the Vercel URL)

# ── Inter-app shared secret (optional) ────────────────────
# SRN_SECRET=  (ShadowRealm/Sigil microservice calls; empty disables that path)

# ── MCP repo-audit tools (optional) ───────────────────────
# GITHUB_TOKEN=  (only the GitHub audit tools in mcp/server.py need this)

# ── CulinaryOS adapter (future) ────────────────────────────
# CULINARYOS_BASE_URL=
# CULINARYOS_API_KEY=
# CULINARYOS_WEBHOOK_SECRET=

# ── LLM gateway extras (optional overrides) ────────────────
# ANTHROPIC_MAX_TOKENS=1024
# GOOGLE_API_KEY=  (alternative to GEMINI_API_KEY)
# CLAUDE_TIMEOUT=30
